# FoodFlow Environment Configuration

# Server Port
PORT=5000

# Security Secrets
JWT_SECRET=foodflow_super_secret_jwt_key_2026

# Google OAuth 2.0 Client Credentials (Google Identity Services)
# Get your Client ID from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Gemini AI API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Email API Key (Recommended for Cloud Hosting / Render)
RESEND_API_KEY=re_your_resend_api_key_here
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
